# MongoDB Connection URI (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/task_manager?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key
JWT_EXPIRES_IN=1d

# Server Environment
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Password-Protected Project Explanation Feature
PROJECT_VIEW_PASSWORD=your_strong_secret_passkey_here
